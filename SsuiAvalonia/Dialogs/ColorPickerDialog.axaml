<flat:ThemedUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:flat="using:SolidShineUi"
             xmlns:ssut="using:SolidShineUi.Utils"
             mc:Ignorable="d" Height="535" Width="410"
             x:Class="SolidShineUi.ColorPickerDialog" x:Name="window" >
    <UserControl.Styles>
        <Style Selector="ssut|ColorSwatchButton.csb" >
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="SetToolTip" Value="False" />
            <!--<Setter Property="AlwaysHexTooltips" Value="False" />-->
            <Setter Property="Margin" Value="1,1,1,1" />
        </Style>
    </UserControl.Styles>
        <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <flat:TabControl x:Name="tabControl" Margin="10" TabMinWidth="0" ShowTabListMenu="False" AllowTabDragDrop="False" >
            <flat:TabItem x:Name="tabSwatches" Title="Swatches" ShowIcon="False" CanClose="False" Padding="10,0" >
                <Grid>
                    <Border BorderBrush="Black" BorderThickness="0" Margin="8,3" >
                        <StackPanel Orientation="Horizontal" Spacing="1" >
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1" >
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightSteelBlue" ToolTip.Tip="LightSteelBlue" />
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="BlueViolet" ToolTip.Tip="BlueViolet" />
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumPurple" ToolTip.Tip="MediumPurple"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumSlateBlue" ToolTip.Tip="MediumSlateBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SlateBlue" ToolTip.Tip="SlateBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SteelBlue" ToolTip.Tip="SteelBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MidnightBlue" ToolTip.Tip="MidnightBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkSlateBlue" ToolTip.Tip="DarkSlateBlue"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Lavender" ToolTip.Tip="Lavender"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Thistle" ToolTip.Tip="Thistle"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Plum" ToolTip.Tip="Plum"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Violet" ToolTip.Tip="Violet"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Magenta" ToolTip.Tip="Magenta"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Fuchsia" ToolTip.Tip="Fuchsia"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Orchid" ToolTip.Tip="Orchid"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumOrchid" ToolTip.Tip="MediumOrchid"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkViolet" ToolTip.Tip="DarkViolet"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkOrchid" ToolTip.Tip="DarkOrchid"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkMagenta" ToolTip.Tip="DarkMagenta"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Purple" ToolTip.Tip="Purple"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Indigo" ToolTip.Tip="Indigo"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1" >
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Snow" ToolTip.Tip="Snow"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MistyRose" ToolTip.Tip="MistyRose"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkSalmon" ToolTip.Tip="DarkSalmon"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightCoral" ToolTip.Tip="LightCoral"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="RosyBrown" ToolTip.Tip="RosyBrown"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="IndianRed" ToolTip.Tip="IndianRed"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Red" ToolTip.Tip="Red"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Crimson" ToolTip.Tip="Crimson"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Firebrick" ToolTip.Tip="Firebrick"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Brown" ToolTip.Tip="Brown"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkRed" ToolTip.Tip="DarkRed"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Maroon" ToolTip.Tip="Maroon"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1" >
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SeaShell" ToolTip.Tip="SeaShell"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Linen" ToolTip.Tip="Linen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LavenderBlush" ToolTip.Tip="LavenderBlush"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Pink" ToolTip.Tip="Pink"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightPink" ToolTip.Tip="LightPink"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="HotPink" ToolTip.Tip="HotPink"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PaleVioletRed" ToolTip.Tip="PaleVioletRed"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DeepPink" ToolTip.Tip="DeepPink"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumVioletRed" ToolTip.Tip="MediumVioletRed"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="FloralWhite" ToolTip.Tip="FloralWhite"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PapayaWhip" ToolTip.Tip="PapayaWhip"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Moccasin" ToolTip.Tip="Moccasin"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PeachPuff" ToolTip.Tip="PeachPuff"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="NavajoWhite" ToolTip.Tip="NavajoWhite"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightSalmon" ToolTip.Tip="LightSalmon"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Orange" ToolTip.Tip="Orange"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkOrange" ToolTip.Tip="DarkOrange"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Salmon" ToolTip.Tip="Salmon"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Coral" ToolTip.Tip="Coral"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Tomato" ToolTip.Tip="Tomato"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="OrangeRed" ToolTip.Tip="OrangeRed"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Cornsilk" ToolTip.Tip="Cornsilk"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="OldLace" ToolTip.Tip="OldLace"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="AntiqueWhite" ToolTip.Tip="AntiqueWhite"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="BlanchedAlmond" ToolTip.Tip="BlanchedAlmond"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Bisque" ToolTip.Tip="Bisque"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Wheat" ToolTip.Tip="Wheat"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Tan" ToolTip.Tip="Tan"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="BurlyWood" ToolTip.Tip="BurlyWood"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SandyBrown" ToolTip.Tip="SandyBrown"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Peru" ToolTip.Tip="Peru"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Chocolate" ToolTip.Tip="Chocolate"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Sienna" ToolTip.Tip="Sienna"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SaddleBrown" ToolTip.Tip="SaddleBrown"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Ivory" ToolTip.Tip="Ivory"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightYellow" ToolTip.Tip="LightYellow"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Beige" ToolTip.Tip="Beige"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightGoldenrodYellow" ToolTip.Tip="LightGoldenrodYellow"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LemonChiffon" ToolTip.Tip="LemonChiffon"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PaleGoldenrod" ToolTip.Tip="PaleGoldenrod"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Khaki" ToolTip.Tip="Khaki"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Yellow" ToolTip.Tip="Yellow"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Gold" ToolTip.Tip="Gold"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkKhaki" ToolTip.Tip="DarkKhaki"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Goldenrod" ToolTip.Tip="Goldenrod"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkGoldenrod" ToolTip.Tip="DarkGoldenrod"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Olive" ToolTip.Tip="Olive"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Honeydew" ToolTip.Tip="Honeydew"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="GreenYellow" ToolTip.Tip="GreenYellow"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Chartreuse" ToolTip.Tip="Chartreuse"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LawnGreen" ToolTip.Tip="LawnGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Lime" ToolTip.Tip="Lime"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LimeGreen" ToolTip.Tip="LimeGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="YellowGreen" ToolTip.Tip="YellowGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="OliveDrab" ToolTip.Tip="OliveDrab"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="ForestGreen" ToolTip.Tip="ForestGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Green" ToolTip.Tip="Green"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkOliveGreen" ToolTip.Tip="DarkOliveGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkGreen" ToolTip.Tip="DarkGreen"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MintCream" ToolTip.Tip="MintCream"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PaleGreen" ToolTip.Tip="PaleGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Aquamarine" ToolTip.Tip="Aquamarine"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SpringGreen" ToolTip.Tip="SpringGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightGreen" ToolTip.Tip="LightGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumSpringGreen" ToolTip.Tip="MediumSpringGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumAquamarine" ToolTip.Tip="MediumAquamarine"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkSeaGreen" ToolTip.Tip="DarkSeaGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="CadetBlue" ToolTip.Tip="CadetBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumSeaGreen" ToolTip.Tip="MediumSeaGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SeaGreen" ToolTip.Tip="SeaGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkSlateGray" ToolTip.Tip="DarkSlateGray"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Azure" ToolTip.Tip="Azure"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightCyan" ToolTip.Tip="LightCyan"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PaleTurquoise" ToolTip.Tip="PaleTurquoise"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="PowderBlue" ToolTip.Tip="PowderBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightBlue" ToolTip.Tip="LightBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Cyan" ToolTip.Tip="Cyan/Aqua"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Turquoise" ToolTip.Tip="Turquoise"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumTurquoise" ToolTip.Tip="MediumTurquoise"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkTurquoise" ToolTip.Tip="DarkTurquoise"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightSeaGreen" ToolTip.Tip="LightSeaGreen"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkCyan" ToolTip.Tip="DarkCyan"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Teal" ToolTip.Tip="Teal"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="AliceBlue" ToolTip.Tip="AliceBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SkyBlue" ToolTip.Tip="SkyBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightSkyBlue" ToolTip.Tip="LightSkyBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DeepSkyBlue" ToolTip.Tip="DeepSkyBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DodgerBlue" ToolTip.Tip="DodgerBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="CornflowerBlue" ToolTip.Tip="CornflowerBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="RoyalBlue" ToolTip.Tip="RoyalBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Blue" ToolTip.Tip="Blue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="MediumBlue" ToolTip.Tip="MediumBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkBlue" ToolTip.Tip="DarkBlue"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Navy" ToolTip.Tip="Navy"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="30" Spacing="1">
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="White" ToolTip.Tip="White"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="GhostWhite" ToolTip.Tip="GhostWhite"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="WhiteSmoke" ToolTip.Tip="WhiteSmoke"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Gainsboro" ToolTip.Tip="Gainsboro"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightGray" ToolTip.Tip="LightGray"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Silver" ToolTip.Tip="Silver"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DarkGray" ToolTip.Tip="DarkGray"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="LightSlateGray" ToolTip.Tip="LightSlateGray"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="SlateGray" ToolTip.Tip="SlateGray"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="Gray" ToolTip.Tip="Gray"/>
                                <ssut:ColorSwatchButton Classes="csb" Click="ColorButton_Click" Color="DimGray" ToolTip.Tip="DimGray"/>
