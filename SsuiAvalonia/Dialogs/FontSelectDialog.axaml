<flat:ThemedUserControl xmlns="https://github.com/avaloniaui"
						xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						mc:Ignorable="d" Height="550" Width="480"
						xmlns:flat="using:SolidShineUi"
						xmlns:conv="using:SolidShineUi.Converters"
						xmlns:sys="using:System"
						x:Class="SolidShineUi.FontSelectDialog" x:Name="window" FontSize="12" >
	<flat:ThemedUserControl.Resources>
		<conv:FontWeightValueConverter x:Key="fvc" />
		<conv:FontWeightStringConverter x:Key="fwc" />
	</flat:ThemedUserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="90"/>
			<RowDefinition Height="23"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="64"/>
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock HorizontalAlignment="Left" Margin="25,15,0,0" Text="Font:" VerticalAlignment="Top"/>
			<TextBox x:Name="txtFont" Height="24" Margin="25,35,10,0" VerticalAlignment="Top" MinWidth="190"
					 flat:AutoCompleteBehavior.AutoCompleteStringComparison="OrdinalIgnoreCase" Padding="6,2"
					 TextChanged="txtFont_TextChanged" MinHeight="24" />
			<ListBox x:Name="lstFont" Margin="25,60,10,10" SelectionChanged="lstFont_SelectionChanged"
					 BorderBrush="Black" BorderThickness="1" >
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Height="18" ToolTip.Tip="{Binding}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="3,0" Text="{Binding}" FontFamily="{Binding}" />
							<!--<TextBlock Grid.Column="1" Margin="3" VerticalAlignment="Center" Text="AaBbCc123!@#$" FontFamily="{Binding}" />-->

						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
			</ListBox>
			<!--DataContext="{x:Static Fonts.SystemFontFamilies}" ItemsSource='{Binding}' />-->

			<TextBlock HorizontalAlignment="Left" Margin="13,15,0,0" Text="Font weight:" VerticalAlignment="Top" x:Name="lblWeight" Grid.Column="1" />
			<flat:IntegerSpinner x:Name="txtWeight" Height="23" Margin="10,35,10,0" VerticalAlignment="Top" MinValue="1" Step="50" MaxValue="999" Value="400"
								 ValueChanged="txtWeight_ValueChanged" Grid.Column="1" />
			<ListBox x:Name="lstWeight" Margin="10,60,10,10" Grid.Column="1" Width="120" SelectionChanged="lstWeight_SelectionChanged"
					 BorderBrush="Black" BorderThickness="1" >
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Height="18">
							<TextBlock VerticalAlignment="Center" Margin="3,0" FontFamily="{Binding ElementName=lstFont, Path=SelectedItem}"
									   FontWeight="{Binding , Converter={StaticResource fvc}}"
									   ToolTip.Tip="{Binding , Converter={StaticResource fwc}}" Text="{Binding , Converter={StaticResource fwc}}" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<sys:Int32>100</sys:Int32>
				<sys:Int32>200</sys:Int32>
				<sys:Int32>300</sys:Int32>
				<sys:Int32>400</sys:Int32>
				<sys:Int32>500</sys:Int32>
				<sys:Int32>600</sys:Int32>
				<sys:Int32>700</sys:Int32>
				<sys:Int32>800</sys:Int32>
				<sys:Int32>900</sys:Int32>
				<sys:Int32>950</sys:Int32>
			</ListBox>

			<TextBlock HorizontalAlignment="Left" Margin="7,15,0,0" Text="Size:" VerticalAlignment="Top" x:Name="lblSize" Grid.Column="2" />
			<flat:DoubleSpinner x:Name="txtSize" Height="23" Margin="10,35,10,0" VerticalAlignment="Top" Width="90" MinValue="1" Step="1" MaxValue="800" Value="10"
								ValueChanged="txtSize_ValueChanged" Grid.Column="2" />
			<ListBox x:Name="lstSize" Margin="10,60,10,10" Width="90" SelectionChanged="lstSize_SelectionChanged" Grid.Column="2"
					 BorderBrush="Black" BorderThickness="1" >
				<sys:Int32>6</sys:Int32>
				<sys:Int32>7</sys:Int32>
				<sys:Int32>8</sys:Int32>
				<sys:Int32>9</sys:Int32>
				<sys:Int32>10</sys:Int32>
				<sys:Int32>11</sys:Int32>
				<sys:Int32>12</sys:Int32>
				<sys:Int32>14</sys:Int32>
				<sys:Int32>16</sys:Int32>
				<sys:Int32>18</sys:Int32>
				<sys:Int32>20</sys:Int32>
				<sys:Int32>22</sys:Int32>
				<sys:Int32>24</sys:Int32>
				<sys:Int32>26</sys:Int32>
				<sys:Int32>28</sys:Int32>
				<sys:Int32>30</sys:Int32>
				<sys:Int32>32</sys:Int32>
				<sys:Int32>36</sys:Int32>
				<sys:Int32>40</sys:Int32>
				<sys:Int32>44</sys:Int32>
				<sys:Int32>48</sys:Int32>
				<sys:Int32>52</sys:Int32>
				<sys:Int32>56</sys:Int32>
				<sys:Int32>60</sys:Int32>
				<sys:Int32>64</sys:Int32>
				<sys:Int32>72</sys:Int32>
				<sys:Int32>80</sys:Int32>
				<sys:Int32>88</sys:Int32>
				<sys:Int32>96</sys:Int32>
			</ListBox>
		</Grid>

		<TextBlock HorizontalAlignment="Left" Margin="25,2,0,0" Text="Styles/Decorations:" VerticalAlignment="Top" x:Name="lblStyles" Grid.Row="1" />

		<WrapPanel Orientation="Vertical" ItemHeight="24" ItemWidth="110" ItemSpacing="5" Grid.Row="1" Margin="25,27,25,5" > 
		<flat:CheckBox x:Name="chkOverline" Content="Overline" Checked="chkOverline_Checked" Unchecked="chkOverline_Unchecked"
					   Grid.Row="1" Padding="5,0" />
		<flat:CheckBox x:Name="chkStrike" Content="Strikethrough" Checked="chkStrike_Checked" Unchecked="chkStrike_Unchecked"
					   Grid.Row="1" Padding="5,0" />
		<flat:CheckBox x:Name="chkUnderline" Content="Underline" Checked="chkUnderline_Checked" Unchecked="chkUnderline_Unchecked"
					   Grid.Row="1" Padding="5,0" />
		<flat:CheckBox x:Name="chkBaseline" Content="Baseline" Checked="chkBaseline_Checked" Unchecked="chkBaseline_Unchecked"
					   Grid.Row="1" Padding="5,0" />
		<flat:CheckBox x:Name="chkItalic" Content="Italic" Checked="chkItalic_Checked" Unchecked="chkItalic_Unchecked"
					   Grid.Row="1" Padding="5,0" />
		<flat:CheckBox x:Name="chkOblique" Content="Oblique" Checked="chkOblique_Checked" Unchecked="chkOblique_Unchecked"
					   Grid.Row="1" Padding="5,0" />
		</WrapPanel>

		<!--<TextBlock HorizontalAlignment="Left" Margin="240,250,0,0" Text="Font color:" VerticalAlignment="Top"/>-->

		<TextBlock HorizontalAlignment="Left" Margin="25,1,0,0" Text="Preview:" VerticalAlignment="Top" x:Name="lblPreview" Grid.Row="2" />

		<Border Height="90" Margin="25,5,25,5" VerticalAlignment="Top" BorderThickness="1"  Grid.Row="3"
				BorderBrush="{Binding ElementName=window, Path=BorderBrush, TargetNullValue=Black, FallbackValue=Black}"
				Background="{Binding ElementName=window, Path=SsuiTheme.PanelBackground, TargetNullValue=White, FallbackValue=White}" >
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" >
				<TextBlock x:Name="txtPreview" Text="{Binding ElementName=window, Path=PreviewText}"
						   VerticalAlignment="Center" HorizontalAlignment="Center"
						   FontFamily="{Binding ElementName=lstFont, Path=SelectedItem}" FontSize="{Binding ElementName=txtSize, Path=Value}"
						   FontWeight="{Binding ElementName=txtWeight, Path=Value, Converter={StaticResource fvc}}" />
			</ScrollViewer>
		</Border>

		<!--<flat:FlatButton x:Name="btnText" Content="Set Preview Text..." HorizontalAlignment="Left" Margin="25,0,0,25" VerticalAlignment="Bottom" Width="120" Click="btnText_Click" Grid.Row="4"/>-->
		<!--<flat:FlatButton x:Name="btnApply" Content="Apply" HorizontalAlignment="Right" Margin="0,0,205,25" VerticalAlignment="Bottom" Width="80"/>-->
		<flat:FlatButton x:Name="btnOK" Content="OK" HorizontalAlignment="Right" Margin="0,0,110,25" VerticalAlignment="Bottom" Width="80" Click="btnOK_Click" Grid.Row="4"/>
		<flat:FlatButton x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Right" Margin="0,0,25,25" VerticalAlignment="Bottom" Width="80" Click="btnCancel_Click" Grid.Row="4"/>
	</Grid>
</flat:ThemedUserControl>
