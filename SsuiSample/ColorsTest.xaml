<flat:ThemedUserControl x:Class="SsuiSample.ColorsTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SsuiSample"
             xmlns:flat="clr-namespace:SolidShineUi;assembly=SolidShineUi"
             xmlns:utils="clr-namespace:SolidShineUi.Utils;assembly=SolidShineUi"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="20,20,0,0" Text="Colors Test" FontSize="16" VerticalAlignment="Top"/>
        <Grid Margin="20,60,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <flat:SelectPanel x:Name="selInputs" ScrollChanged="selInputs_ScrollChanged" Grid.Row="2" />
            <flat:SelectPanel x:Name="selResult" ScrollChanged="selResult_ScrollChanged" Grid.Row="2" Grid.Column="2"/>
            <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" Text="Inputs:" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" Text="Results:" VerticalAlignment="Center" Grid.Column="2"/>
            <StackPanel Grid.Row="1" Height="24" Orientation="Horizontal" >
                <flat:FlatButton Margin="4,0" x:Name="btnAdd" Click="btnAdd_Click" >Add Color...</flat:FlatButton>
                <flat:FlatButton Margin="4,0" x:Name="btnAddX11" Click="btnAddX11_Click" >Add X11 Colors</flat:FlatButton>
                <flat:FlatButton Margin="8,0,0,0" x:Name="btnRemove" Click="btnRemove_Click" >Remove</flat:FlatButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="2" Margin="10,0">
                <TextBlock Text="Function to apply:" />
                <ComboBox x:Name="cbbFunction" Margin="0,4" SelectionChanged="cbbFunction_SelectionChanged" >
                    <ComboBoxItem>Invert</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Flat)</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Rec 601)</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Rec 709)</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Rec 601, no gamma)</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Rec 709, no gamma)</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Desaturate)</ComboBoxItem>
                    <ComboBoxItem>Grayscale (Luminance)</ComboBoxItem>
                    <ComboBoxItem>Convert to Pure Hue</ComboBoxItem>
                    <ComboBoxItem>Blend 25%</ComboBoxItem>
                    <ComboBoxItem>Blend 50%</ComboBoxItem>
                    <ComboBoxItem>Blend 75%</ComboBoxItem>
                    <ComboBoxItem>Blend 25%, no gamma</ComboBoxItem>
                    <ComboBoxItem>Blend 50%, no gamma</ComboBoxItem>
                    <ComboBoxItem>Blend 75%, no gamma</ComboBoxItem>
                    <ComboBoxItem>Convert to HSV and Back</ComboBoxItem>
                    <ComboBoxItem>Convert to HSL and Back</ComboBoxItem>
                    <ComboBoxItem>Multiply by 2</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Blend color:" Margin="0,6,0,0"/>
                <utils:ColorSwatchButton Margin="0,4" Color="White" x:Name="btnColor" Click="btnColor_Click" />
                <TextBlock Text="Display colors as:" Margin="0,24,0,0" />
                <flat:EnumComboBox x:Name="cbbDisplay" Enum="{x:Type utils:ColorListItemDisplay}" 
                                   SelectionChanged="cbbDisplay_SelectionChanged" />
            </StackPanel>
            <flat:CheckBox Grid.Column="2" Content="Match scroll positions" IsChecked="True" x:Name="chkScrollMatch"
                           HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="1" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</flat:ThemedUserControl>
