<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net4.8;net6.0-windows;net8.0-windows10.0.19041.0;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\Icons\Icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Images\*.png" />
		<Resource Include="Resources\Images\*.png" />
		<None Remove="Resources\Images\32\*.png" />
		<Resource Include="Resources\Images\32\*.png" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'net6.0-windows' ">
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0-windows' ">
		<Nullable>enable</Nullable>
	</PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0-windows10.0.19041.0' ">
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0-windows' ">
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Icon.ico" />
		<Resource Include="Resources\Icon.ico" />
	</ItemGroup>

